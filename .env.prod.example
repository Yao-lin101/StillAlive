# Django 设置
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DOMAIN=your-domain.com

# 数据库设置
DB_NAME=smtx
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=3306

# Redis 设置
REDIS_HOST=redis
REDIS_PORT=6379

# 邮件设置
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@example.com

# SSL 证书路径
SSL_CERTIFICATE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/your-domain.com/privkey.pem

# 安全设置
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True 

# Media
MEDIA_URL=https://your-domain.com

# Character Display
CHARACTER_DISPLAY_BASE_URL=https://your-domain.com

# Anthropic AI (for Daily Report Analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Important Event Long-term Memory
IMPORTANT_EVENT_MEMORY_ENABLED=True
IMPORTANT_EVENT_VECTOR_ENABLED=True
IMPORTANT_EVENT_INITIAL_RECALL=50
IMPORTANT_EVENT_PINNED_LIMIT=3
IMPORTANT_EVENT_INFRA_CHECK_ON_STARTUP=True
IMPORTANT_EVENT_QUERY_REWRITE_ENABLED=True
IMPORTANT_EVENT_QUERY_REWRITE_MAX_TOKENS=4096

# Ollama Embedding
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_EMBED_DIM=1024
OLLAMA_EMBED_MAX_CHARS=400

# Milvus Vector Index
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_IMPORTANT_EVENT_COLLECTION=stillalive_important_events
