# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=django-insecure-development-key
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.188,*

# Database
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Email
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@example.com

# Media
MEDIA_URL=your-media-url

# Character Display
CHARACTER_DISPLAY_BASE_URL=http://localhost:5173

# Anthropic AI (for Daily Report Analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Important Event Long-term Memory
IMPORTANT_EVENT_MEMORY_ENABLED=True
IMPORTANT_EVENT_VECTOR_ENABLED=True
IMPORTANT_EVENT_INITIAL_RECALL=50
IMPORTANT_EVENT_PINNED_LIMIT=3
IMPORTANT_EVENT_INFRA_CHECK_ON_STARTUP=True
IMPORTANT_EVENT_QUERY_REWRITE_ENABLED=True
IMPORTANT_EVENT_QUERY_REWRITE_MAX_TOKENS=4096

# Ollama Embedding
# 注意：以下仅为「嵌入模型配置」单例首次创建时的默认值；运行时以 admin 后台配置为准
# （后台支持 Ollama / OpenAI 兼容，可填 base_url / api_key / 模型 / 维度并热生效）。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_EMBED_DIM=1024
OLLAMA_EMBED_MAX_CHARS=400

# 向量后端：auto | pgvector | milvus | none
# auto（默认）优先用 Postgres 的 pgvector（无需 Milvus）；如需保留 Milvus 请设为 milvus。
VECTOR_BACKEND=auto

# Milvus Vector Index（仅 VECTOR_BACKEND=milvus 时需要）
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_IMPORTANT_EVENT_COLLECTION=important_events
